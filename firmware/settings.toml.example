# GhostType Wi-Fi Configuration
# Copy this file to settings.toml and fill in your credentials.
# NEVER commit settings.toml to version control.

CIRCUITPY_WIFI_SSID = "YourNetworkName"
CIRCUITPY_WIFI_PASSWORD = "YourPassword"

# mDNS hostname -> reachable at http://<MDNS_HOSTNAME>.local
# Optional. Defaults to "pico-kbd" if omitted.
# Use a unique value per device (e.g. "pico-kbd-2") to run multiple keyboards.
MDNS_HOSTNAME = "pico-kbd"
